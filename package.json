{
  "name": "ai-marker-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "security:check": "bash scripts/check-no-secrets.sh",
    "momo:sandbox": "tsx scripts/momo-sandbox-setup.ts",
    "momo:diagnose": "tsx scripts/momo-diagnose.ts",
    "test": "npm run security:check && node --test --import tsx tests/*.test.ts",
    "eval": "tsx evals/runner.ts",
    "eval:ci": "tsx evals/runner.ts --split dev --all --no-report",
    "nisr:index": "tsx scripts/nisr-index.ts",
    "nisr:validate": "tsx scripts/nisr-index.ts --validate",
    "eval:documents": "tsx scripts/eval-documents.ts",
    "verify": "npm run lint && npm run test && npm run build",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dagrejs/dagre": "^3.1.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@google/genai": "^2.13.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.12.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/three": "0.169.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.17.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.5",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "docx": "^9.5.0",
    "dotenv": "^17.2.3",
    "e2b": "^2.38.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "moment": "^2.30.1",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "prisma": "^5.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
