# --- MySEB backend ---
PORT=4000
DATABASE_URL=postgres://myseb:myseb@localhost:5432/myseb
# Public URL students/phones can reach (used in QR codes and the default exam URL). On a LAN use http://<laptop-ip>:4000
PUBLIC_URL=http://localhost:4000
# Teachers sign in to the dashboard with this key. Use a long random string (openssl rand -hex 24).
TEACHER_KEY=change-me-teacher-key
# Server-side pepper for hashing codes / tokens. Never ship it to any client. (openssl rand -hex 32)
PEPPER=change-me-long-random-pepper
# Seconds without a heartbeat before an IN_EXAM student is marked LEFT
HEARTBEAT_TIMEOUT_SECONDS=20
# Hours a code stays valid if the exam has no hard end time
CODE_TTL_HOURS=12
