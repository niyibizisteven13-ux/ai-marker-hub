{
  "name": "myseb-desktop",
  "productName": "MySEB",
  "version": "1.0.0",
  "description": "MySEB secure exam browser (desktop)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "MYSEB_DEV=1 electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "space.bwenge.myseb",
    "productName": "MySEB",
    "files": ["src/**", "renderer/**", "config.json", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.education" },
    "linux": { "target": "AppImage" }
  }
}
