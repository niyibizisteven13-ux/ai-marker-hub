{
  "manifest_version": 3,
  "name": "TestBlocker",
  "version": "1.0",
  "description": "Administrative extension to block access to: tiktok.com, instagram.com",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}