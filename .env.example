# Template only. Copy it to a protected environment file and replace every placeholder.
# Never commit real secrets or use these example values in a live deployment.
# Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example
APP_BASE_URL=https://your-domain.example

# Telegram bot credentials belong only in the server's secret environment.
# Never paste the token into chat, browser settings, or source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Bwengebot
TELEGRAM_BOT_SECRET_TOKEN=
# Optional custom emoji icons on Telegram buttons, by feature (mark, scan, create, transcribe, library, files, settings,
# help, back, regenerate, menu, retry, openScan, openMark), e.g. {"mark":"5368324170671202286"}. Shown only when the
# bot owner has Telegram Premium or the bot has a Fragment username; otherwise the standard emoji stay.
TELEGRAM_BUTTON_ICONS=

# Docker Compose uses the service name `postgres`. For a host/PM2 install, use 127.0.0.1.
# URL-encode special characters in the PostgreSQL password.
DATABASE_URL=postgresql://bwenge_app:CHANGE_ME@postgres:5432/ai_marker_hub?schema=public
POSTGRES_PASSWORD=
APP_DATABASE_USER=bwenge_app
APP_DATABASE_PASSWORD=

# Keep these independent, random, and at least 32 characters long.
JWT_SECRET=
FILE_URL_SECRET=

# Gmail SMTP or another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=
SMTP_FROM=Bwenge AI Studio <noreply@your-domain.example>
# Optional: SMTP_SECURE=true for port 465, SMTP_REPLY_TO=support@your-domain.example

# MTN Mobile Money (Collections). See docs/BILLING_MOMO.md. Leave empty until MTN issues the keys;
# checkout then shows "payments are being set up" and nothing is faked.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_COLLECTION_PRIMARY_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# "sandbox" for testing; the production value MTN gives you (Rwanda: mtnrwanda).
MOMO_TARGET_ENV=sandbox
# RWF in production; the sandbox only accepts EUR.
MOMO_CURRENCY=
# Public HTTPS base that MTN calls back (must match the callback host registered with MTN).
MOMO_CALLBACK_HOST=https://www.bwenge.space
# USD→RWF fallback rate; admins can override it in Admin → Billing.
FX_USD_RWF=1470

# Configure the provider used by your deployment.
AI_PROVIDER=gonkarouter
GONKA_API_KEY=
GONKA_BASE_URL=https://api.gonkarouter.io/v1
# Default model for every task class. Class-specific models are optional and are only
# used when set; leave them empty until the model id is confirmed on the gateway.
GONKA_MODEL=zai-org/GLM-5.3-Flash
GONKA_ECONOMICAL_MODEL=
GONKA_PREMIUM_MODEL=
# Fallback for simple/standard requests on transient failures only (never for complex/artifact work).
GONKA_FALLBACK_MODEL=
GONKA_FALLBACK_SUPPORTS_VISION=false
# Set to "off" to send every request to GONKA_MODEL (pre-routing behaviour).
AI_MODEL_ROUTING=on

# Big tasks (long/multi-document work, comparisons, charts/quizzes) can use a second provider.
# Everyday chat always stays on Gonka. gonka (default) | deepseek | openrouter
AI_COMPLEX_PROVIDER=gonka
DEEPSEEK_API_KEY=
DEEPSEEK_COMPLEX_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_COMPLEX_MODEL=
# If the big-task provider fails, answer with Gonka instead of failing.
AI_COMPLEX_FALLBACK_TO_GONKA=true
# Image requests stay on Gonka unless the big-task model accepts images.
AI_COMPLEX_SUPPORTS_VISION=false
AI_COMPLEX_REQUEST_TIMEOUT_MS=900000

# Provider reliability (milliseconds unless noted). AI_TOTAL_DEADLINE_MS only limits retries before the first output;
# answers stream with a heartbeat every 15 s, so long generations are not cut by the proxy.
AI_CONNECT_TIMEOUT_MS=15000
AI_IDLE_TIMEOUT_MS=120000
AI_REQUEST_TIMEOUT_MS=900000
AI_TOTAL_DEADLINE_MS=45000
AI_MAX_ATTEMPTS=3
AI_INITIAL_BACKOFF_MS=500
AI_MAX_BACKOFF_MS=8000
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_MS=30000
# Optional per-model prices (USD per 1M tokens) for cost estimates; unknown models report no cost.
AI_MODEL_PRICING_JSON=

# Agent tasks (tool loops, rubric assessment, report interpretation) on Claude. Opt-in:
# set AI_AGENT_PROVIDER=anthropic and an API key. Everyday chat stays on Gonka either way.
# Verify model access and billing on your Anthropic account before enabling in production.
AI_AGENT_PROVIDER=gonka
ANTHROPIC_API_KEY=
CLAUDE_AGENT_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max (Haiku 5.5 default: medium)
CLAUDE_EFFORT=medium
CLAUDE_FALLBACK_TO_GONKA=true
# Examination marking (marking schemes, handwriting, marks) can use a larger model than everyday agent tasks.
# Empty = the agent model. Recommended for accuracy: claude-opus-5-5 with high effort (costs more per script).
CLAUDE_MARKING_MODEL=
CLAUDE_MARKING_EFFORT=
# Whole-document analysis in chat (analyze_document, e.g. a 900-page book): reads the document section by
# section. "marking" runs it on the marking model above (more capable, costs more); empty uses the agent model.
DOCUMENT_MODEL=
# Claude researches the web (search + read pages) on agent turns and cites its sources. false turns it off;
# MAX_USES caps searches per reply (each search is billed by Anthropic on top of tokens).
CLAUDE_WEB_SEARCH=
CLAUDE_WEB_SEARCH_MAX_USES=
# Characters per section (default 90000, about 25 pages).
DOC_SECTION_CHARS=
CLAUDE_REQUEST_TIMEOUT_MS=120000

# Background jobs (reports, assessments) and stored records. Use durable volumes.
JOBS_DIR=./data/jobs
JOBS_CONCURRENCY=2
JOBS_MAX_ACTIVE_PER_USER=5
ASSESSMENTS_DIR=./data/assessments

# Scanned/handwritten documents (/api/documents). Recognition needs a vision model: Claude
# (AI_AGENT_PROVIDER=anthropic) or set DOC_VISION_GONKA=true only if your Gonka model accepts images.
DOCUMENTS_DIR=./data/documents
DOC_MAX_PAGES=20
DOC_VISION_GONKA=false
DOC_VISION_MODEL=
# Independent Tesseract cross-check on text regions (uses the bundled eng.traineddata).
DOC_OCR_CROSSCHECK=true
TESSERACT_DATA_DIR=
# OCR languages (+-separated); add fra/kin .traineddata files to TESSERACT_DATA_DIR before listing them.
TESSERACT_LANG=eng
# Close-up tiling for large pages with small writing: auto | always | off.
DOC_TILING=auto
DOC_MAX_TILES_PER_PAGE=4
# PDF render scale (x 72 DPI).
DOC_PDF_SCALE=3
# Flag elements for review on any uncertainty signal (medium) or only high-severity ones (high).
DOC_REVIEW_THRESHOLD=medium

# Examination marking through the chat and /api/exams (docs/EXAM_MARKING.md). Needs the vision/agent model above.
EXAMS_DIR=./data/exams
EXAM_CANDIDATE_CONCURRENCY=2
EXAM_MAX_CANDIDATES=100
EXAM_SEGMENT_BUDGET_MS=480000
EXAM_CHAT_WAIT_MS=900000
EXAM_MAX_FILES_PER_UPLOAD=30
# Largest single generated file (bytes); raise for big marking packages. Default 25 MB.
FILE_STORE_MAX_BYTES=

# Knowledge repositories (/api/admin/knowledge, docs/KNOWLEDGE_REPOSITORY.md). Embeddings use GEMINI_API_KEY;
# without it files are indexed for keyword search and marked pending_embeddings.
KNOWLEDGE_MAX_FILE_BYTES=104857600
KNOWLEDGE_MAX_FILES_PER_UPLOAD=500
KNOWLEDGE_REPO_QUOTA_BYTES=5368709120
KNOWLEDGE_INDEX_CONCURRENCY=2
KNOWLEDGE_OCR=true
KNOWLEDGE_TMP_DIR=

# Universal output engine (/api/outputs, analyze_data / create_output tools; docs/OUTPUT_ENGINE.md).
# Statistics run in an isolated python3 subprocess (needs: pip install numpy pandas). Without them a smaller
# TypeScript fallback is used and filters, group-by, pivot, distributions and moving averages are unavailable.
ANALYSIS_PYTHON=python3
ANALYSIS_TIMEOUT_MS=90000
ANALYSIS_MEM_MB=1024
ANALYSIS_CPU_SECONDS=60
ANALYSIS_MAX_CONCURRENCY=2
ANALYSIS_MAX_ROWS=200000
ANALYSIS_MAX_INPUT_BYTES=52428800
# Network isolation uses `unshare -rn` when the kernel allows it; set true to refuse to run without it.
ANALYSIS_REQUIRE_NETWORK_NAMESPACE=false
# Chat requests for files/charts/computed numbers always use the tool agent (Claude when AI_AGENT_PROVIDER=anthropic).
ENABLE_OUTPUT_ENGINE_TOOLS=true

# NISR dataset index (see data/nisr/README.md). Defaults: data/nisr and data/nisr/index.
NISR_DATA_DIR=
NISR_INDEX_DIR=
NISR_REQUIRE_APPROVAL=false
NISR_MAX_FILE_MB=50
NISR_MAX_ROWS=200000

# Persistent paths inside the app container; map these to durable volumes.
FILE_STORE_DIR=./data/generated

# Chat attachments: largest file in MB (files above 8 MB upload first, then go with the message).
CHAT_MAX_FILE_MB=100
# How long a request body may take to arrive (ms); slow 100 MB uploads need more than Node's 5-minute default.
REQUEST_TIMEOUT_MS=1800000
# Automatic marking is for upgraded plans (GO, PRO, Institution). Set to false to open it to every plan.
MARKING_REQUIRES_UPGRADE=true
