# ================================================================
# AI Marker Hub — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ================================================================

# --- Runtime ---
NODE_ENV="development"         # Set to "production" in deployed environments
PORT="3000"
APP_URL="http://localhost:5173" # Frontend URL — used for CORS in production
APP_BASE_URL="http://localhost:3000"
JWT_EXPIRES_IN="1h"

# --- Auth (REQUIRED — server will refuse to start without JWT_SECRET) ---
JWT_SECRET=""                  # REQUIRED: at least 32 random characters

# --- AI Providers (configure at least one) ---
AI_PROVIDER="gonkarouter"       # Default provider: gonkarouter, anthropic, gemini, etc.

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"          # Optional override — defaults to gemini-3.8-flash
GEMINI_PRO_MODEL="gemini-3.8-pro"

ANTHROPIC_API_KEY=""

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_TOKENS="5000"

NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_MODEL="meta/llama-4-scout-17b-16e-instruct"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o"

GONKA_API_KEY=""
GONKA_BASE_URL="https://api.gonkarouter.io/v1"
GONKA_MODEL="zai-org/GLM-5.3-Flash"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# --- Database (REQUIRED) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_marker_hub?schema=public"  # PostgreSQL for local dev and production; SQLite is not allowed in production

# --- Queue (Redis — required if BullMQ is enabled) ---
REDIS_URL="redis://localhost:6379"

# --- Durable storage (production) ---
STORAGE_DRIVER="local" # Set to s3 only after configuring a real S3-compatible adapter
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_SECRET_TOKEN=""
