# Template only. Copy it to a protected environment file and replace every placeholder.
# Never commit real secrets or use these example values in a live deployment.
# Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example

# Docker Compose uses the service name `postgres`. For a host/PM2 install, use 127.0.0.1.
# URL-encode special characters in the PostgreSQL password.
DATABASE_URL=postgresql://bwenge_app:CHANGE_ME@postgres:5432/ai_marker_hub?schema=public
POSTGRES_PASSWORD=
APP_DATABASE_USER=bwenge_app
APP_DATABASE_PASSWORD=

# Keep these independent, random, and at least 32 characters long.
JWT_SECRET=
FILE_URL_SECRET=

# Gmail SMTP or another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=
SMTP_FROM=Bwenge AI Studio <noreply@your-domain.example>

# Configure the provider used by your deployment.
AI_PROVIDER=gonkarouter
GONKA_API_KEY=
GONKA_BASE_URL=https://api.gonkarouter.io/v1

# Persistent paths inside the app container; map these to durable volumes.
FILE_STORE_DIR=./data/generated
