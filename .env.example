# ── Bwenge AI Studio Production Environment Configuration (www.bwenge.com) ──

# Application & Domain
NODE_ENV=production
APP_URL=https://www.bwenge.com
PORT=3000

# Security (Must be at least 32 characters long)
JWT_SECRET=your-super-secure-jwt-secret-key-min-32-chars-here
FILE_URL_SECRET=your-super-secure-file-url-secret-min-16-chars
FILE_STORE_DIR=./data/generated
ALLOW_GEMINI_FALLBACK=false

# Database (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://postgres:your_db_password@your-rds-endpoint:5432/ai_marker_hub?schema=public

# Redis Queue (AWS ElastiCache Redis)
REDIS_URL=redis://your-elasticache-endpoint:6379

# AI Gateway & Providers (GonkaRouter & Multimodel Backends)
AI_PROVIDER=gonkarouter
GONKA_API_KEY=your-gonka-router-api-key
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GEMINI_API_KEY=your-google-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-claude-api-key
OPENAI_API_KEY=your-openai-api-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key

# Storage (AWS S3 or Local)
STORAGE_DRIVER=s3
S3_BUCKET=bwenge-ai-production-storage
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# SMTP Email Service (For Production Authentication & Notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
SMTP_FROM="Bwenge AI Studio <noreply@bwenge.com>"
