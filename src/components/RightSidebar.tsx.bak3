import React, { useState, useRef } from 'react';
import { 
  Sparkles, 
  Send, 
  Copy, 
  Check, 
  RefreshCw, 
  Layers, 
  Trash2, 
  Globe, 
  Quote,
  Paperclip,
  Camera,
  Mic,
  MicOff,
  FileCheck,
  X,
  FileText,
  ScrollText,
  CheckCircle2,
  Clock
} from 'lucide-react';
import { AICard, UploadedFile, ExamPaper } from '../types';
import { processFileClientSide } from '../utils/fileProcessor';

interface RightSidebarProps {
  aiCards: AICard[];
  setAiCards: React.Dispatch<React.SetStateAction<AICard[]>>;
  onAskAI: (query: string) => void;
  isAiLoading: boolean;
  onSaveToDeck: (card: AICard) => void;
  onUploadMasterExam?: (file: File) => void;
  uploadedFiles?: UploadedFile[];
  examPaper?: ExamPaper | null;
}

export const RightSidebar: React.FC<RightSidebarProps> = ({
  aiCards,
  setAiCards,
  onAskAI,
  isAiLoading,
  onSaveToDeck,
  onUploadMasterExam,
  uploadedFiles = [],
  examPaper = null,
}) => {
  const [activeRightTab, setActiveRightTab] = useState<'exam_questions' | 'marking_log'>('exam_questions');
  const [chatInput, setChatInput] = useState('');
  const [copiedId, setCopiedId] = useState<string | null>(null);

  // Editable Exam Questions Canvas State
  const initialExamText = examPaper?.content || `# Master Exam Questions

### Question 1: Classical Mechanics & Dynamics (10 Marks)
a) State Newton's Second Law in terms of rate of change of momentum. Derive F = ma for constant mass. [3 Marks]
b) A 1500 kg rocket accelerates vertically from rest. Calculate net force required to achieve 12 m/s² acceleration. [3 Marks]
c) Demonstrate conservation of total linear momentum in an isolated two-body elastic collision. [4 Marks]

### Question 2: Thermodynamics & Ideal Gases (10 Marks)
a) Define internal energy of an ideal gas and state the First Law of Thermodynamics ΔU = Q - W. [3 Marks]
b) A gas sample expands at constant pressure 1.01 × 10⁵ Pa from 0.02 m³ to 0.05 m³. Calculate work done. [3 Marks]
c) Differentiate between reversible isothermal and adiabatic processes with appropriate P-V diagrams. [4 Marks]

### Question 3: Wave Optics & Interference (10 Marks)
a) Explain the principle of superposition and condition for constructive interference. [3 Marks]
b) Light of wavelength λ = 632.8 nm passes through double slits 0.20 mm apart. Screen distance D = 1.5 m. Find fringe width. [4 Marks]
c) State Rayleigh's criterion for optical resolution of two point sources. [3 Marks]`;

  const [examText, setExamText] = useState<string>(initialExamText);
  const [examHtml, setExamHtml] = useState<string | null>(null);
  
  // Multi-Modal state
  const [attachedFile, setAttachedFile] = useState<File | null>(null);
  const [isRecording, setIsRecording] = useState(false);
  const [isCameraActive, setIsCameraActive] = useState(false);
  const [modalFeedback, setModalFeedback] = useState<string | null>(null);

  const masterFileInputRef = useRef<HTMLInputElement>(null);

  const handleSend = (e: React.FormEvent) => {
    e.preventDefault();
    if ((!chatInput.trim() && !attachedFile && !isRecording) || isAiLoading) return;

    let queryText = chatInput.trim();
    if (attachedFile) {
      queryText = `[Attached Master Answer Key: ${attachedFile.name}] ${queryText}`;
    }
    if (isRecording) {
      queryText = `[Voice Grading Rules] ${queryText || 'Analyze audio dictation and evaluate student script response against rules.'}`;
    }

    onAskAI(queryText);
    setChatInput('');
    setAttachedFile(null);
    setIsRecording(false);
    setIsCameraActive(false);
  };

  const handleMasterFileSelect = async (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      const file = e.target.files[0];
      setAttachedFile(file);
      if (onUploadMasterExam) {
        onUploadMasterExam(file);
      }
      
      const processed = await processFileClientSide(file);
      if (processed.htmlContent) {
        setExamHtml(processed.htmlContent);
      } else {
        setExamHtml(null);
      }
      setExamText(processed.rawText);
      setModalFeedback(`Loaded & Processed Master File: ${file.name}`);
      setTimeout(() => setModalFeedback(null), 3000);
    }
  };

  const handleDropOnExamCanvas = async (e: React.DragEvent) => {
    e.preventDefault();
    if (e.dataTransfer.files && e.dataTransfer.files[0]) {
      const file = e.dataTransfer.files[0];
      setAttachedFile(file);
      if (onUploadMasterExam) {
        onUploadMasterExam(file);
      }
      const processed = await processFileClientSide(file);
      if (processed.htmlContent) {
        setExamHtml(processed.htmlContent);
      } else {
        setExamHtml(null);
      }
      setExamText(processed.rawText);
      setModalFeedback(`Loaded & Processed Master Key: ${file.name}`);
      setTimeout(() => setModalFeedback(null), 3000);
    }
  };

  const handleToggleVoice = () => {
    if (!isRecording) {
      setIsRecording(true);
      setModalFeedback('Voice dictation for grading rules active...');
    } else {
      setIsRecording(false);
      setModalFeedback('Voice grading rules saved to prompt.');
      setTimeout(() => setModalFeedback(null), 2500);
    }
  };

  const handleTriggerCamera = () => {
    setIsCameraActive(true);
    setModalFeedback('Camera Scanner ready. Captured master key rules.');
    setTimeout(() => {
      setModalFeedback('Master rules scanned via Camera OCR');
      setTimeout(() => setModalFeedback(null), 2500);
    }, 1200);
  };

  const handleCopyCitation = (card: AICard) => {
    const citation = `"${card.sourceText || card.content}" — Synthesized via AI Marker Hub (${card.timestamp})`;
    navigator.clipboard.writeText(citation);
    setCopiedId(card.id);
    setTimeout(() => setCopiedId(null), 2000);
  };

  const handleRemoveCard = (id: string) => {
    setAiCards(aiCards.filter((c) => c.id !== id));
  };

  return (
    <aside className="w-80 lg:w-96 h-[calc(100vh-61px)] bg-[#FBF9F6] dark:bg-[#141416] border-l border-[#E8E4DC] dark:border-[#2D2D32] flex flex-col justify-between shrink-0 select-none">
      {/* 1. Upper Header Zone: Dual-Tab Configuration */}
      <div className="p-2 border-b border-[#E8E4DC] dark:border-[#2D2D32] bg-[#F4F0E8]/60 dark:bg-[#1C1C1F]/80 flex items-center gap-1.5 shrink-0">
        <button
          type="button"
          onClick={() => setActiveRightTab('exam_questions')}
          className={`flex-1 py-2 px-3 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-1.5 cursor-pointer ${
            activeRightTab === 'exam_questions'
              ? 'bg-[#FFFFFF] dark:bg-[#202024] text-[#191919] dark:text-[#F3F3F3] shadow-xs border border-[#E8E4DC] dark:border-[#2D2D32]'
              : 'text-[#66635B] dark:text-[#A0A0AA] hover:bg-[#E8E4DC]/50 dark:hover:bg-[#252529]'
          }`}
        >
          <FileText className="w-3.5 h-3.5 text-[#D97757]" />
          <span>Exam Questions</span>
        </button>

        <button
          type="button"
          onClick={() => setActiveRightTab('marking_log')}
          className={`flex-1 py-2 px-3 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-1.5 cursor-pointer ${
            activeRightTab === 'marking_log'
              ? 'bg-[#FFFFFF] dark:bg-[#202024] text-[#191919] dark:text-[#F3F3F3] shadow-xs border border-[#E8E4DC] dark:border-[#2D2D32]'
              : 'text-[#66635B] dark:text-[#A0A0AA] hover:bg-[#E8E4DC]/50 dark:hover:bg-[#252529]'
          }`}
        >
          <ScrollText className="w-3.5 h-3.5 text-[#D97757]" />
          <span>Marking Log</span>
        </button>
      </div>

      {/* TAB 1: "Exam Questions" (Interactive & Editable Open Text Canvas) */}
      {activeRightTab === 'exam_questions' && (
        <div
          onDragOver={(e) => e.preventDefault()}
          onDrop={handleDropOnExamCanvas}
          className="flex-1 overflow-hidden flex flex-col p-4 relative"
        >
          {examHtml ? (
            <div
              contentEditable
              suppressContentEditableWarning
              onInput={(e) => setExamText(e.currentTarget.innerText)}
              className="w-full h-full overflow-y-auto bg-transparent text-xs text-[#191919] dark:text-[#F3F3F3] leading-relaxed outline-none border-none focus:ring-0 select-text p-1 font-sans"
              dangerouslySetInnerHTML={{ __html: examHtml }}
            />
          ) : (
            <textarea
              value={examText}
              onChange={(e) => setExamText(e.target.value)}
              placeholder="Type or paste exam questions here, or drop files directly (.docx, .pdf, .pptx, images)..."
              className="w-full h-full bg-transparent text-xs font-mono text-[#191919] dark:text-[#F3F3F3] leading-relaxed outline-none resize-none selection:bg-[#D97757]/20 border-none focus:ring-0 select-text"
              spellCheck={false}
            />
          )}
        </div>
      )}

      {/* TAB 2: "Marking Log" (Automated Real-Time Scrolling Progress Ticker List) */}
      {activeRightTab === 'marking_log' && (
        <div className="flex-1 overflow-y-auto p-3 space-y-2 select-text">
          {/* Live Progress Banner */}
          <div className="px-3 py-1.5 rounded-lg bg-[#D97757]/10 border border-[#D97757]/20 flex items-center justify-between text-[11px] font-mono font-bold text-[#D97757]">
            <div className="flex items-center space-x-1.5">
              <span className="w-2 h-2 rounded-full bg-[#D97757] animate-ping" />
              <span>Live Marking Progress Ticker</span>
            </div>
            <span>
              {uploadedFiles.length > 0 ? `${uploadedFiles.length} Papers Active` : 'Queue Idle'}
            </span>
          </div>

          {/* Dynamic Real-Time Scrolling Ticker List from State */}
          <div className="space-y-1.5 font-mono text-xs">
            {uploadedFiles.length > 0 ? (
              uploadedFiles.map((file, idx) => {
                const studentNum = idx + 1;
                const isSoftDeleted = file.isSoftDeleted;
                const isFlagged = file.isFlagged;
                const bonus = file.bonusMarks || 0;
                
                // Deterministic realistic score simulation based on index and bonus
                const baseScore = Math.min(50, 36 + ((idx * 7 + 5) % 13));
                const totalScore = Math.min(50, baseScore + bonus);
                const percentage = Math.round((totalScore / 50) * 100);

                return (
                  <div
                    key={file.id || idx}
                    className={`p-2.5 rounded-xl border transition-all flex items-center justify-between ${
                      isSoftDeleted
                        ? 'bg-rose-500/5 border-rose-500/20 text-[#858075] opacity-60'
                        : isFlagged
                        ? 'bg-amber-500/10 border-amber-500/30 text-amber-600 dark:text-amber-400'
                        : 'bg-white dark:bg-[#202024] border-[#E8E4DC] dark:border-[#2D2D32] hover:border-[#D97757]'
                    }`}
                  >
                    <div className="flex items-center space-x-2 truncate pr-2">
                      {isSoftDeleted ? (
                        <Trash2 className="w-3.5 h-3.5 text-rose-500 shrink-0" />
                      ) : isFlagged ? (
                        <Clock className="w-3.5 h-3.5 text-amber-500 shrink-0" />
                      ) : (
                        <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
                      )}
                      <div className="truncate">
                        <div className="font-bold text-[11px] text-[#191919] dark:text-[#F3F3F3] truncate">
                          Student Paper {studentNum}: {isSoftDeleted ? 'Minimized' : `Marked (${totalScore}/50)`}
                          {bonus > 0 && <span className="text-amber-500 ml-1">+{bonus} Bonus</span>}
                        </div>
                        <div className="text-[10px] text-[#858075] dark:text-[#888892] truncate">
                          {file.studentName || file.name} {isFlagged ? '• Flagged for Review' : `• Grade: ${percentage}%`}
                        </div>
                      </div>
                    </div>

                    {!isSoftDeleted && (
                      <span className={`px-2 py-0.5 rounded-md text-[10px] font-bold shrink-0 ${
                        isFlagged 
                          ? 'bg-amber-500/15 text-amber-600 dark:text-amber-400' 
                          : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
                      }`}>
                        {percentage}%
                      </span>
                    )}
                  </div>
                );
              })
            ) : (
              /* Empty state prompt with zero hardcoded text lists */
              <div className="p-6 rounded-2xl bg-[#FFFFFF] dark:bg-[#202024] border border-dashed border-[#E8E4DC] dark:border-[#2D2D32] text-center space-y-2 my-4">
                <ScrollText className="w-8 h-8 text-[#D97757] mx-auto opacity-80" />
                <div className="font-bold text-xs text-[#191919] dark:text-[#F3F3F3]">
                  No Student Papers Loaded in Queue
                </div>
                <div className="text-[11px] text-[#858075] dark:text-[#888892] leading-relaxed font-sans">
                  Upload student answer sheets or trigger simulated batch upload in the middle panel to view automated real-time marking progress.
                </div>
              </div>
            )}

            {/* AI Evaluation Insights Cards if present */}
            {aiCards.length > 0 && (
              <div className="pt-3 border-t border-[#E8E4DC] dark:border-[#2D2D32] space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-bold text-[#858075] dark:text-[#888892] uppercase tracking-wider">
                    AI Evaluation Logs ({aiCards.length})
                  </span>
                  <button
                    onClick={() => setAiCards([])}
                    className="text-[10px] font-mono text-[#858075] hover:text-[#D97757] transition-colors cursor-pointer"
                  >
                    Clear Logs
                  </button>
                </div>
                {aiCards.map((card) => (
                  <div
                    key={card.id}
                    className="p-3 rounded-xl bg-[#FFFFFF] dark:bg-[#202024] border border-[#E8E4DC] dark:border-[#2D2D32] space-y-2"
                  >
                    <div className="flex items-center justify-between text-[11px] font-bold text-[#191919] dark:text-[#F3F3F3]">
                      <div className="flex items-center space-x-1.5">
                        <Sparkles className="w-3.5 h-3.5 text-[#D97757]" />
                        <span>{card.title}</span>
                      </div>
                      <div className="flex items-center space-x-1">
                        <span className="text-[10px] font-mono text-[#858075]">{card.timestamp}</span>
                        <button
                          onClick={() => handleRemoveCard(card.id)}
                          className="p-0.5 rounded text-[#858075] hover:text-rose-500 transition-colors"
                        >
                          <Trash2 className="w-3 h-3" />
                        </button>
                      </div>
                    </div>

                    {card.sourceText && (
                      <div className="p-1.5 rounded-lg bg-[#F4F0E8]/70 dark:bg-[#18181A] text-[10px] italic text-[#52504A] dark:text-[#A0A0AA] line-clamp-2">
                        <Quote className="w-3 h-3 inline mr-1 text-[#D97757]" />
                        "{card.sourceText}"
                      </div>
                    )}

                    <div className="text-xs text-[#191919] dark:text-[#F3F3F3] leading-relaxed font-sans whitespace-pre-wrap">
                      {card.content}
                    </div>

                    <div className="pt-1 border-t border-[#E8E4DC]/80 dark:border-[#2D2D32] flex items-center justify-between text-[10px] text-[#66635B] dark:text-[#A0A0AA]">
                      <button
                        onClick={() => handleCopyCitation(card)}
                        className="flex items-center space-x-1 hover:text-[#D97757] transition-colors cursor-pointer"
                      >
                        {copiedId === card.id ? (
                          <>
                            <Check className="w-3 h-3 text-emerald-500" />
                            <span className="text-emerald-500 font-bold">Copied</span>
                          </>
                        ) : (
                          <>
                            <Copy className="w-3 h-3" />
                            <span>Copy Citation</span>
                          </>
                        )}
                      </button>

                      <button
                        onClick={() => onSaveToDeck(card)}
                        className="flex items-center space-x-1 hover:text-[#D97757] transition-colors cursor-pointer"
                      >
                        <Layers className="w-3 h-3" />
                        <span>Save to Deck</span>
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      {/* Bottom Input Zone: Master Answer Key & Multi-Modal Grading Hub */}
      <div className="p-3 border-t border-[#E8E4DC] dark:border-[#2D2D32] bg-[#F4F0E8]/70 dark:bg-[#18181A] space-y-2 shrink-0">
        {/* Hidden File Input for Master Answer Key */}
        <input
          type="file"
          ref={masterFileInputRef}
          onChange={handleMasterFileSelect}
          accept=".pdf,.png,.jpg,.jpeg,.docx,.txt"
          className="hidden"
        />

        {/* Status Toast Notification */}
        {modalFeedback && (
          <div className="px-3 py-1.5 rounded-lg bg-[#D97757]/15 border border-[#D97757]/30 text-[11px] font-mono font-medium text-[#D97757] flex items-center justify-between animate-in fade-in">
            <span>{modalFeedback}</span>
            <button onClick={() => setModalFeedback(null)}>
              <X className="w-3 h-3" />
            </button>
          </div>
        )}

        {/* Multi-Modal Attachment Pill Indicators */}
        {(attachedFile || isRecording || isCameraActive) && (
          <div className="flex flex-wrap gap-1.5 pt-1">
            {attachedFile && (
              <span className="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg bg-[#FFFFFF] dark:bg-[#202024] border border-[#E8E4DC] dark:border-[#2D2D32] text-[10px] font-mono text-[#191919] dark:text-[#F3F3F3]">
                <FileCheck className="w-3 h-3 text-[#D97757]" />
                <span className="truncate max-w-[120px]">{attachedFile.name}</span>
                <button onClick={() => setAttachedFile(null)} className="hover:text-rose-500">
                  <X className="w-3 h-3" />
                </button>
              </span>
            )}

            {isRecording && (
              <span className="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg bg-rose-500/10 border border-rose-500/30 text-[10px] font-mono text-rose-600 dark:text-rose-400 animate-pulse">
                <Mic className="w-3 h-3" />
                <span>Voice Exam Rules Active</span>
                <button onClick={() => setIsRecording(false)}>
                  <X className="w-3 h-3" />
                </button>
              </span>
            )}

            {isCameraActive && (
              <span className="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg bg-[#5B92E5]/10 border border-[#5B92E5]/30 text-[10px] font-mono text-[#5B92E5]">
                <Camera className="w-3 h-3" />
                <span>Scan Rules via Camera</span>
                <button onClick={() => setIsCameraActive(false)}>
                  <X className="w-3 h-3" />
                </button>
              </span>
            )}
          </div>
        )}

        {/* Input Bar with Master Answer Key Actions */}
        <form onSubmit={handleSend} className="relative flex flex-col p-2 rounded-2xl bg-[#FFFFFF] dark:bg-[#202024] border border-[#E8E4DC] dark:border-[#2D2D32] focus-within:border-[#D97757] transition-all space-y-2">
          {/* Main Text Input */}
          <textarea
            rows={2}
            value={chatInput}
            onChange={(e) => setChatInput(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                handleSend(e);
              }
            }}
            placeholder="Upload Master Answer Key or enter grading rules..."
            className="w-full px-2 py-1 bg-transparent text-xs text-[#191919] dark:text-[#F3F3F3] placeholder-[#858075] dark:placeholder-[#66635B] outline-none resize-none"
          />

          {/* Action Tools Bar */}
          <div className="flex items-center justify-between pt-1 border-t border-[#E8E4DC]/50 dark:border-[#2D2D32]">
            <div className="flex items-center space-x-1">
              {/* 1. Upload Master Answer Key */}
              <button
                type="button"
                onClick={() => masterFileInputRef.current?.click()}
                className="p-1.5 rounded-lg text-[#66635B] dark:text-[#A0A0AA] hover:text-[#D97757] hover:bg-[#F4F0E8] dark:hover:bg-[#2D2D32] transition-colors cursor-pointer"
                title="Upload Master Answer Key (PDF/Image/DOCX)"
              >
                <Paperclip className="w-4 h-4" />
              </button>

              {/* 2. Scan Exam Rules via Camera */}
              <button
                type="button"
                onClick={handleTriggerCamera}
                className={`p-1.5 rounded-lg transition-colors cursor-pointer ${
                  isCameraActive
                    ? 'text-[#5B92E5] bg-[#5B92E5]/15'
                    : 'text-[#66635B] dark:text-[#A0A0AA] hover:text-[#5B92E5] hover:bg-[#F4F0E8] dark:hover:bg-[#2D2D32]'
                }`}
                title="Scan Exam Rules via Camera/Voice"
              >
                <Camera className="w-4 h-4" />
              </button>

              {/* 3. Audio/Voice Feedback Dictation */}
              <button
                type="button"
                onClick={handleToggleVoice}
                className={`p-1.5 rounded-lg transition-colors cursor-pointer ${
                  isRecording
                    ? 'text-rose-500 bg-rose-500/15 animate-pulse'
                    : 'text-[#66635B] dark:text-[#A0A0AA] hover:text-rose-500 hover:bg-[#F4F0E8] dark:hover:bg-[#2D2D32]'
                }`}
                title="Record Voice Exam Rules"
              >
                {isRecording ? <MicOff className="w-4 h-4" /> : <Mic className="w-4 h-4" />}
              </button>
            </div>

            {/* Send / Evaluate Button */}
            <button
              type="submit"
              disabled={(!chatInput.trim() && !attachedFile && !isRecording) || isAiLoading}
              className="px-3 py-1.5 rounded-xl bg-[#D97757] hover:bg-[#C05A3E] disabled:opacity-40 text-white font-bold text-xs flex items-center space-x-1.5 transition-all cursor-pointer shadow-2xs"
            >
              <span>Evaluate</span>
              <Send className="w-3.5 h-3.5" />
            </button>
          </div>
        </form>
      </div>

      <input
        type="file"
        ref={masterFileInputRef}
        onChange={handleMasterFileSelect}
        accept=".pdf,.docx,.doc,.pptx,.ppt,.png,.jpg,.jpeg,.txt"
        className="hidden"
      />
    </aside>
  );
};
